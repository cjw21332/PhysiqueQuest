{
  "name": "physique-quest",
  "private": true,
  "main": "mobile/index.ts",
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "expo": "npm run start --workspace mobile",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "coach": "npm --prefix backend run start:coach",
    "coach:dev": "npm --prefix backend run start:coach:dev",
    "seed": "npm --prefix backend run seed:exercises",
    "ai:setup": "node ai/setup.mjs",
    "ai:check": "node ai/setup.mjs --check",
    "ai:warmup": "node ai/setup.mjs --warmup",
    "ai:evaluate": "node ai/setup.mjs --warmup && npm --prefix backend run build && node backend/scripts/evaluate-chat.mjs",
    "ai:evaluate:questions": "npm --prefix backend run build && node backend/scripts/evaluate-chat-questions.mjs",
    "ai:evaluate:paraphrases": "npm --prefix backend run build && node backend/scripts/evaluate-chat-paraphrases.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "expo": "^58.0.21",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "expo-mediapipe-pose": {
      "expo": "~58.0.21",
      "react-native": "0.88.1"
    }
  },
  "workspaces": [
    "frontend",
    "mobile"
  ]
}
