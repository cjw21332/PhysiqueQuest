# Copy to .env and fill in. Never commit the filled-in file.

# --- Core backend ---------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/physiquequest
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Exact trusted proxy-hop count (0 for direct API; 1 for Next proxy).
TRUST_PROXY=1
DB_MAX_POOL_SIZE=20
# MIN_APP_VERSION=1.0.0
REQUIRE_APP_VERSION=false
LEGACY_AUTH_ENABLED=true
# Phase 3 only: set false AFTER deployed version enforcement and zero legacy use.
# Production: NODE_ENV=production, COOKIE_SECURE=true, COOKIE_SAMESITE=lax.
# Set CORS_ALLOWED_ORIGINS to the exact public HTTPS frontend origin(s).
# COOKIE_DOMAIN should normally stay unset for host-only cookies.
# none is allowed only with COOKIE_SECURE=true for truly cross-site HTTPS.
# API_PUBLIC_URL=https://app.example.com
# COACH_PORT=4050
# COACH_FRONTEND_URL=http://localhost:3000

# Preferred password-reset email provider (EmailJS). Set the service, template,
# and public key from EmailJS; the private key is optional and stays server-side.
# Template source and logo setup: email-templates/README.md.
# The EmailJS template consumes {{email}}, {{name}}, {{passcode}}, and {{time}}.
# EMAILJS_* names are accepted as aliases for backward compatibility.
SERVICE_ID=
TEMPLATE_ID=
PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Alias names, accepted in place of SERVICE_ID / TEMPLATE_ID / PUBLIC_KEY.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=

# Optional legacy delivery endpoint used when EmailJS is not configured. The
# backend POSTs { template, to, token, expiresInMinutes } to this endpoint.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_API_KEY=

# Optional service endpoints for confirmed emergency delivery and pose analysis.
ALERT_DELIVERY_URL=
ALERT_DELIVERY_API_KEY=
POSE_ANALYSIS_URL=
POSE_ANALYSIS_API_KEY=

# Admin access is off by default. Provision a trusted user explicitly in MongoDB;
# see the admin provisioning instructions in backend/README.md.

# --- Food scanning --------------------------------------------------------
# Both provider keys are optional: without them the app still boots and every
# other route keeps working, but the scan endpoints answer 503.
GEMINI_API_KEY=
USDA_API_KEY=

# Optional overrides.
# GEMINI_MODEL=gemini-3.6-flash
# Reasoning effort. The configured models think before answering, which under a
# structured-output schema pushed a scan past its time budget. LOW returns the
# same JSON far faster. One of MINIMAL, LOW, MEDIUM, HIGH.
# GEMINI_THINKING_LEVEL=LOW
# Attempts per scan, including the first. Retries only cover a busy provider
# answering 503; quota and timeout failures are reported immediately.
# GEMINI_ATTEMPTS=3
# USDA_BASE=https://api.nal.usda.gov/fdc/v1

# Request budgets. The JSON body limit is derived from the image limit unless
# set explicitly, and must be large enough to carry a base64 encoded image.
# Keep FOODSCAN_REQUEST_TIMEOUT_MS well under 60000: the mobile client stops
# waiting at 60s, and a longer server deadline would keep billing the vision
# provider for a result the user has already abandoned. The default 25000 is far
# inside that, and FOODSCAN_UPSTREAM_TIMEOUT_MS caps any single vision call
# regardless of the deadline above it.
# FOODSCAN_MAX_IMAGE_BYTES=4194304
# FOODSCAN_MAX_BODY_BYTES=
# FOODSCAN_MAX_SEARCH_QUERY_LENGTH=120
# FOODSCAN_MAX_DETECTED_ITEMS=12
# FOODSCAN_REQUEST_TIMEOUT_MS=25000
# FOODSCAN_UPSTREAM_TIMEOUT_MS=20000

# Per-user rate limiting on the scan route.
# FOODSCAN_RATE_LIMIT_ENABLED=true
# FOODSCAN_RATE_LIMIT_MAX=60
# FOODSCAN_RATE_LIMIT_WINDOW_MS=60000

# --- Logging and proxying -------------------------------------------------
# LOG_LEVEL=info
# Number of trusted reverse-proxy hops to read client IPs from. Keep at 0 when
# the app is reached directly, or a client can spoof its IP past the rate limit.
# TRUST_PROXY_HOPS=0
# Generated API documentation: explicit development/test opt-in only; always off in production.
SWAGGER_ENABLED=false
# Optional for dev, mandatory for production: a private random 32-byte base64 key.
# Keep outside Git and preserve for restore; never use a public EXPO_/NEXT_PUBLIC_ variable.
HEALTH_DATA_ENCRYPTION_KEY=

# Privacy & retention: positive integers. No inactivity-based account expiry.
ACCOUNT_DELETION_GRACE_DAYS=30
MEDIA_ORIGINAL_TTL_HOURS=24
ORPHAN_UPLOAD_TTL_HOURS=24
COMPLETED_JOB_TTL_HOURS=24
FAILED_JOB_TTL_DAYS=7
AUDIT_LOG_HOT_DAYS=90
AUDIT_LOG_RETENTION_MONTHS=12
REFRESH_TOKEN_RECORD_BUFFER_DAYS=30

# Provider adapters. Local development requires no cloud accounts.
MAIL_PROVIDER=console
MAIL_FROM=PhysiqueQuest <noreply@example.invalid>
MAILPIT_URL=http://127.0.0.1:8025
MAIL_API_KEY=
EMAIL_VERIFICATION_ENFORCED=false
EMAIL_VERIFICATION_TTL_MINUTES=60
EMAIL_VERIFICATION_URL=http://localhost:3000
PUSH_PROVIDER=dry-run
EXPO_ACCESS_TOKEN=
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
CDN_SIGNING_KEY=
SENTRY_DSN=
# Backup scripts only; separate credentials/identity and encrypted storage.
# BACKUP_RETENTION_DAYS=35
# BACKUP_ENCRYPTION_KEY=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_LOCAL_DIR=.data/backups
# BACKUP_S3_BUCKET=
# BACKUP_SOURCE_DATABASE=physiquequest
# RESTORE_MONGODB_URI=
# LOAD_TEST_CONCURRENCY=10
# LOAD_TEST_REQUESTS=200
# LOAD_TEST_REPORT=
# LOAD_TEST_TOKEN=
# LOAD_TEST_URL=http://127.0.0.1:4000
# READINESS_URL=http://127.0.0.1:4000
# RUNTIME_TEST_REPORT=
