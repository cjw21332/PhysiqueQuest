# Copy to .env for local development, or set these in your platform's dashboard
# for a deployed environment. Never commit a filled-in copy of this file.
#
# Generate the shared secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ===========================================================================
# REQUIRED - the service refuses to start without these
# ===========================================================================

# Shared secret the main backend presents in the X-Internal-Api-Key header.
# Must be at least 32 characters. Placeholder values are rejected at boot.
SERVICE_TOKEN=CHANGE_ME_generate_a_32_plus_character_random_string

# Logical name of the calling service, recorded on every audit log line.
SERVICE_ID=main-backend

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# USDA FoodData Central API key (https://api.data.gov)
USDA_API_KEY=

# ===========================================================================
# Model
# ===========================================================================

# Vision model used for food detection. Do not use the 2.5 generation: it is
# retired on 2026-10-16.
GEMINI_MODEL=gemini-3.5-flash

# ===========================================================================
# OPTIONAL - defaults shown
# ===========================================================================

# Port to listen on. Your platform usually injects this; Render sets it
# automatically and it must be left unset there.
# PORT=3001

# Interface to bind. Must be 0.0.0.0 on Render: its router cannot reach a
# process bound to loopback.
# HOST=0.0.0.0

# Fatal, error, warn, info (default), debug, trace, or silent
# LOG_LEVEL=info

# Number of reverse proxies in front of this service, used to resolve the real
# client IP. Set to 1 behind Render or the bundled nginx. Leave at 0 otherwise:
# a value above the true proxy count lets a client spoof X-Forwarded-For.
# TRUST_PROXY_HOPS=0

# Total time budget for one request, and the per-upstream-call timeout.
# REQUEST_TIMEOUT_MS=20000
# UPSTREAM_TIMEOUT_MS=10000

# Largest accepted image after base64 decoding.
# MAX_IMAGE_BYTES=4194304

# Hard cap on the JSON request body. Defaults to MAX_IMAGE_BYTES * 4/3 plus
# 64 KiB of headroom for the surrounding fields, so raising MAX_IMAGE_BYTES
# normally needs no change here. Lower it if you want a stricter body cap.
# MAX_BODY_BYTES=

# Longest accepted ?q= search term.
# MAX_SEARCH_QUERY_LENGTH=120

# Cap on foods returned by the vision model. Each one can cost up to two
# nutrition lookups, so this bounds the work a single request can cause.
# MAX_DETECTED_ITEMS=12

# Per-caller request budget, to stop one buggy caller draining provider quota.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# Base URL for the nutrition API.
# USDA_BASE=https://api.nal.usda.gov/fdc/v1

# Comma-separated list of retired tokens still accepted during a rotation.
# Rejected if it contains the active token. Clear it once every caller has
# migrated.
# SERVICE_TOKENS_PREVIOUS=
