# Copy to ai/deploy/.env; it is Git-ignored. Never use development secrets.
APP_DOMAIN=app.your-domain.example
ACME_EMAIL=operator@your-domain.example
MONGODB_URI=
JWT_SECRET=
# Preserve the exact key used to encrypt existing records. Never rotate casually.
HEALTH_DATA_ENCRYPTION_KEY=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=
PUSH_PROVIDER=dry-run
EXPO_ACCESS_TOKEN=
# Separate optional image/food features, not chatbot credentials.
GEMINI_API_KEY=
USDA_API_KEY=
OLLAMA_IMAGE=ollama/ollama:0.40.11
