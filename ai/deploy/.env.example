# Copy to ai/deploy/.env; it is Git-ignored. Never use development secrets.
APP_DOMAIN=app.your-domain.example
ACME_EMAIL=operator@your-domain.example
MONGODB_URI=
JWT_SECRET=
# Preserve the exact key used to encrypt existing records. Never rotate casually.
HEALTH_DATA_ENCRYPTION_KEY=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=
PUSH_PROVIDER=dry-run
EXPO_ACCESS_TOKEN=
# Server-side OpenAI key; never include it in an Android app or Git.
OPENAI_API_KEY=
# Per-user hourly and system-wide daily request limits.
AI_RATE_LIMIT_PER_USER_HOUR=30
AI_RATE_LIMIT_GLOBAL_DAY=500
# Private shared secret for the bundled pose analysis service.
POSE_ANALYSIS_API_KEY=
GOOGLE_WEB_CLIENT_ID=
# Optional credentials for other existing provider features.
GEMINI_API_KEY=
USDA_API_KEY=
