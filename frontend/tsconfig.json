{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-progress-test/types/**/*.ts",
    ".next-progress-test/dev/types/**/*.ts",
    ".next-goals-test/types/**/*.ts",
    ".next-goals-test/dev/types/**/*.ts",
    ".next-phone/types/**/*.ts",
    ".next-phone/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
