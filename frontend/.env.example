# Optional separate AI Coach deployment; otherwise page hostname with port 4050.
# No ExerciseDB credential belongs in frontend environment variables.
# NEXT_PUBLIC_COACH_API_URL=https://your-coach-service.example/api

# Server-only Next proxy upstream. Browser and WebView call their own /api/*.
BACKEND_URL=http://127.0.0.1:4000
# Additional dev frontend hostnames (no scheme/port); set your PC LAN IP/tunnel host.
# DEV_ALLOWED_ORIGINS=192.168.1.42
# Public web release version; required before REQUIRE_APP_VERSION=true on the API.
# NEXT_PUBLIC_APP_VERSION=1.0.0
# Direct cross-origin NEXT_PUBLIC_API_URL overrides require explicit cookie/CORS setup.

# Optional scrubbed error reporting. Browser DSN is a public ingestion identifier.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional private CI source-map upload (never prefix auth token NEXT_PUBLIC_).
# SENTRY_UPLOAD_SOURCEMAPS=false
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
