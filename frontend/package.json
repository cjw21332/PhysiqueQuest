{
  "name": "physique-quest-frontend",
  "private": true,
  "scripts": {
    "prepare:repdb": "node scripts/prepare-repdb.mjs",
    "predev": "npm run prepare:repdb",
    "prebuild": "npm run prepare:repdb",
    "pretypecheck": "npm run prepare:repdb",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app/ components/ hooks/ lib/ sections/ workers/ tests/",
    "test:ui-guard": "node --test tests/mobile-redesign.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --config playwright.tracking.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "oxlint": "1.86.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
