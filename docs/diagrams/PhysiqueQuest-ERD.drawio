        <mxCell id="text-1" value="Solid lines mean containment  |  Child boxes live inside parent documents; they are not separate collections" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#52657a;">
          <mxGeometry x="48" y="66" width="1043.52" height="28" as="geometry" />
        </mxCell>
        <mxCell id="text-2" value="SetResult.exerciseId matches an exercise snapshot within the same workout; string IDs are not catalog foreign keys." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#52657a;">
          <mxGeometry x="48" y="1203" width="1177.45" height="29" as="geometry" />
        </mxCell>
        <mxCell id="text-3" value="sourceRecordingId links an imported planned set to its original reviewed recording; no source video is stored." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#52657a;">
          <mxGeometry x="48" y="1173" width="1127.3" height="29" as="geometry" />
        </mxCell>
        <mxCell id="text-4" value="WorkoutExercise and SetResult are generic object arrays shaped by the workout contract. Other child objects have embedded schemas." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#52657a;">
          <mxGeometry x="48" y="1233" width="1327.8999999999999" height="29" as="geometry" />
        </mxCell>
        <mxCell id="text-5" value="No independent MongoDB _id on the child objects. ? marks optional or nullable fields. PK / UK constraints belong to parent collections." vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#52657a;">
          <mxGeometry x="48" y="1263" width="1378.05" height="29" as="geometry" />
