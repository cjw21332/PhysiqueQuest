        <mxCell id="text-0" value="PhysiqueQuest / Embedded data" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontColor=#15314b;">
