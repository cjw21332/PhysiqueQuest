{
  "expo": {
    "name": "PhysiqueQuest",
    "slug": "physiquequest",
    "scheme": "physiquequest",
    "icon": "./assets/physiquequest-icon.png",
    "version": "1.6.5",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access for exercise rep counting.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PhysiqueQuest uses your location only when an inactivity alarm goes off during a workout, to include it in the alert sent to your emergency contact."
        }
      ]
    ],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f15",
    "splash": {
      "backgroundColor": "#0b0f15"
    },
    "android": {
      "versionCode": 21,
      "package": "com.physiquequest.app",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/physiquequest-icon-round.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/physiquequest-adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0b0f15",
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "com.physiquequest.app",
      "buildNumber": "1",
      "icon": "./assets/physiquequest-icon-ios.png",
      "splash": {
        "backgroundColor": "#0b0f15"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "web": {
      "favicon": "./assets/physiquequest-icon.png"
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://physiquequest-api.onrender.com/api",
      "EXPO_PUBLIC_WEB_APP_URL": "https://physiquequest-web.onrender.com",
      "googleWebClientId": "390685281626-3g9bucvvl5t3sfjg3e6tj0gvaupsdcl5.apps.googleusercontent.com",
      "eas": {
        "projectId": "57fa70dc-7d18-4477-a4bb-c41cf2f3ca93"
      }
    },
    "owner": "charlesjameswalet"
  }
}
