{
  "expo": {
    "name": "PhysiqueQuest",
    "slug": "physiquequest",
    "scheme": "physiquequest",
    "icon": "./assets/physiquequest-icon.png",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "platforms": ["android", "ios"],
    "plugins": [["expo-camera", { "cameraPermission": "Allow camera access for exercise rep counting.", "recordAudioAndroid": false }]],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f15",
    "android": {
      "package": "com.physiquequest.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/physiquequest-icon.png",
        "backgroundColor": "#0b0f15"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content",
      "visible": "leanback"
    },
    "ios": {
      "bundleIdentifier": "com.physiquequest.app",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "iosStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/physiquequest-icon.png"
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "http://192.168.100.5:4000/api",
      "EXPO_PUBLIC_WEB_APP_URL": "http://192.168.100.5:3000"
    }
  }
}
