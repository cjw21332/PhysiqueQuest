{
  "expo": {
    "name": "PhysiqueQuest",
    "slug": "physiquequest",
    "scheme": "physiquequest",
    "icon": "./assets/physiquequest-icon.png",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access for exercise rep counting.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f15",
    "android": {
      "versionCode": 2,
      "package": "com.physiquequest.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/physiquequest-icon.png",
        "backgroundColor": "#0b0f15"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "com.physiquequest.app",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "web": {
      "favicon": "./assets/physiquequest-icon.png"
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://clerk-repeated-pest-packs.trycloudflare.com/api",
      "EXPO_PUBLIC_WEB_APP_URL": "https://clerk-repeated-pest-packs.trycloudflare.com",
      "googleWebClientId": "390685281626-3g9bucvvl5t3sfjg3e6tj0gvaupsdcl5.apps.googleusercontent.com",
      "eas": {
        "projectId": "57fa70dc-7d18-4477-a4bb-c41cf2f3ca93"
      }
    },
    "owner": "charlesjameswalet"
  }
}
