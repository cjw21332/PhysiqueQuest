+++ b/shared/framingGuard.ts
@@ -0,0 +1,25 @@
+/** Pause measurements during unreliable framing; never count bad-frame motion. */
+export const FRAMING_GRACE_MS = 500;
+
+/** Preserve the current cycle through a short dropout, then discard it once. */
+export function createFramingGuard(graceMs = FRAMING_GRACE_MS) {
+  let lostAt: number | null = null;
+  let suspended = false;
+  return {
+    reset() { lostAt = null; suspended = false; },
+    update(timestamp: number, acceptable: boolean): { advance: boolean; suspend: boolean } {
+      if (acceptable) {
+        const expired = lostAt !== null && !suspended && timestamp - lostAt >= graceMs;
+        lostAt = null;
+        suspended = false;
+        return { advance: true, suspend: expired };
+      }
+      if (lostAt === null || timestamp < lostAt) lostAt = timestamp;
+      if (!suspended && timestamp - lostAt >= graceMs) {
+        suspended = true;
+        return { advance: false, suspend: true };
+      }
+      return { advance: false, suspend: false };
+    },
+  };
+}
