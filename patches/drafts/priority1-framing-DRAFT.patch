@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest';
+import { createFramingGuard } from '../framingGuard';
+
+describe('working-joint framing guard', () => {
+  it('does not advance on bad frames and preserves a brief dropout', () => {
+    const guard = createFramingGuard();
+    expect(guard.update(0, true)).toEqual({ advance: true, suspend: false });
+    expect(guard.update(100, false)).toEqual({ advance: false, suspend: false });
+    expect(guard.update(499, false)).toEqual({ advance: false, suspend: false });
+    expect(guard.update(500, true)).toEqual({ advance: true, suspend: false });
+  });
+  it('suspends exactly once after prolonged loss and resumes cleanly', () => {
+    const guard = createFramingGuard();
+    guard.update(100, false);
+    expect(guard.update(600, false)).toEqual({ advance: false, suspend: true });
+    expect(guard.update(700, false)).toEqual({ advance: false, suspend: false });
+    expect(guard.update(800, true)).toEqual({ advance: true, suspend: false });
+  });
+  it('suspends on recovery if no intermediate frame arrived during a long gap', () => {
+    const guard = createFramingGuard();
+    guard.update(100, false);
+    expect(guard.update(700, true)).toEqual({ advance: true, suspend: true });
+  });
+});
